// Eingebaute Funktionen: Zahlen lesen, Antwortmuster, Text, Geometrie (semantik.md, Abschnitt 4).

item zahlen_lesen "Zahlen lesen" {
  spaced = Num(of: number("34 000"))
  dotted = Num(of: number("34.000"))
  unit = Num(of: number("4,25 m"))
  dollar = Num(of: number("$15"))
  percent = Num(of: number("62,2 %"))
  frac = Num(of: number("3/4"))
  leading_zero = Num(of: number("0.250"))
  minus = Num(of: number("-5"))
  grouped_decimal = Num(of: number("1 234,5"))
  de = Num(of: number("einundzwanzig"))
  de_long = Num(of: number("eintausendvierhundertfünfundsechzig"))
  en = Num(of: number("twenty-one"))
  fr = Num(of: number("vingt et un"))
  word_unit = Num(of: number("zwei Äpfel"))
  two_numbers = Num(of: number("4 or 5"))
  empty = Num(of: number(""))
  p_percent = Num(of: proportion("25 %"))
  p_ratio = Num(of: proportion("1:4"))
  p_decimal = Num(of: proportion("0,25"))
  p_odds = Num(of: proportion("1 zu 3"))
  r_two = Flag(of: rounds_to("0,03", 1/33))
  r_percent = Flag(of: rounds_to("3,03 %", 1/33))
  r_whole_percent = Flag(of: rounds_to("3 %", 1/33))
  r_zero = Flag(of: rounds_to("0", 1/33))
  r_zero_digits = Flag(of: rounds_to("0", 1/33, digits: 1))
  r_wrong = Flag(of: rounds_to("0,04", 1/33))
  q_cm = Num(of: quantity("3 m", "cm"))
  q_same = Num(of: quantity("300 cm", "cm"))
  q_dollar = Num(of: quantity("$15", "$"))
  q_word = Num(of: quantity("15 dollars", "$"))
  q_fr = Num(of: quantity("4,25 mètres", "m"))
  q_twice = Num(of: quantity("12 cm cm", "cm"))
  q_numberword = Num(of: quantity("zwei Meter", "cm"))
  q_time = Num(of: quantity("1,5 h", "min"))
  q_wrong_dim = Num(of: quantity("4 kg", "m"))
  q_no_unit = Num(of: quantity("15", "cm"))
  reduced = Flag(of: is_reduced("3/4"))
  not_reduced = Flag(of: is_reduced("6/8"))
  reduced_int = Flag(of: is_reduced("2"))
  reduced_dec = Flag(of: is_reduced("2,5"))
}

item muster "Antwortmuster" {
  optional = Flag(of: accept("Windmill", "(a) windmill"))
  typo = Flag(of: accept("a windmlil", "(a) windmill", typos: 1))
  typo_off = Flag(of: accept("a windmlil", "(a) windmill"))
  case_on = Flag(of: accept("WINDMILL", "windmill", case: true))
  word_alt = Flag(of: accept("three dark blue cars", "(the) 3/three (red/dark blue) cars"))
  word_alt2 = Flag(of: accept("the 3 red cars", "(the) 3/three (red/dark blue) cars"))
  whole_alt = Flag(of: accept("12 marbles", "a dozen / 12 marbles"))
  digits_exact = Flag(of: accept("1350 marbles", "1250 marbles", typos: 2))
  compound = Flag(of: accept("Gartenzaun", "(Garten-)Zaun"))
  compound_dash = Flag(of: accept("Garten-Zaun", "(Garten-)Zaun"))
  compound_short = Flag(of: accept("Zaun", "(Garten-)Zaun"))
  joined = Flag(of: accept("tooth brush", "toothbrush", typos: 1))
  joined_off = Flag(of: accept("tooth brush", "toothbrush"))
  required = Flag(of: accept("morgens joggen", "morgens [joggen / Sport treiben]"))
  required_missing = Flag(of: accept("morgens", "morgens [joggen / Sport treiben]"))
  punctuation = Flag(of: accept("Bremen!", "Bremen"))
  apostrophe = Flag(of: accept("won’t", "won't"))
  decimal_kept = Flag(of: accept("4.25", "4,25"))
  date = Flag(of: accept("9/4/2011", "9/4/2011"))
  empty_answer = Flag(of: accept("", "(a)"))
  two_of_two = Num(of: accepted(["Norway", "Greece"], ["Greece", "Norway / Norwegen"]))
  same_twice = Num(of: accepted(["Greece", "Greece"], ["Greece", "Norway / Norwegen"]))
  with_typo = Num(of: accepted(["Grecee", "Norwegen"], ["Greece", "Norway / Norwegen"], typos: 1))
}

item text_funktionen "Textfunktionen" {
  removed = Txt(of: normalize("A b  C", case: false, spaces: remove))
  collapsed = Txt(of: normalize(" a  b ", spaces: collapse))
  kept = Txt(of: normalize(" A ", case: true))
  split = TxtList(of: words(" Das ist,  gut. "))
}

item geometrie "Geometrie" {
  p1 = Pt(of: (1 | 2))
  p_none = Pt(of: (1 | number("x")))
  polar_up = Pt(of: polar((0 | 0), 2, 90))
  polar_diag = Pt(of: polar((1 | 1), 1, 45))
  x_of = Num(of: (3 | 4).x)
  dist = Num(of: distance((0 | 0), (3 | 4)))
  dist_root = Num(of: distance((0 | 0), (1 | 1)))
  dist_none = Num(of: distance((0 | 0), none))
  right = Num(of: angle((1 | 0), (0 | 0), (0 | 1)))
  angle_zero = Num(of: angle((0 | 0), (0 | 0), (0 | 1)))
  tri = Num(of: area([(0 | 0), (4 | 0), (0 | 3)]))
  tri_none = Num(of: area([(0 | 0), none, (0 | 3)]))
  two = Num(of: area([(0 | 0), (4 | 0)]))
  steps = Segments(of: shape({[(0 | 0), (2 | 0)]}))
  pieces = Flag(of: shape({[(0 | 0), (2 | 0)]}) == shape({[(2 | 0), (1 | 0)], [(0 | 0), (1 | 0)]}))
  moved = Flag(of: shape({[(3 | 3), (4 | 3)]}) == shape({[(0 | 0), (1 | 0)]}))
  fixed = Flag(of: shape({[(3 | 3), (4 | 3)]}, anywhere: false) == shape({[(0 | 0), (1 | 0)]}, anywhere: false))
  sorted = Segments(of: shape({[(10 | 0), (11 | 0)], [(2 | 0), (3 | 0)]}, anywhere: false))
}
