// Ausdrücke: exakte Zahlen, none, Vergleiche, Mengen, Listen, Text und Inhalt (semantik.md, Abschnitte 2 und 3).

item zahlen "Zahlen" {
  sum = Num(of: 1/3 + 1/6)
  whole = Num(of: 6 / 3)
  neg = Num(of: -(3/4))
  dec = Num(of: 0.1 + 0.2)
  half = Num(of: 7 / 2)
  big = Num(of: 123456789012345678 * 1000)
  safe = Num(of: 9007199254740991)
  unsafe = Num(of: 9007199254740992)
  product = Num(of: 2/3 * 9/4)
  difference = Num(of: 1 - 5/4)
  missing = Num(of: number("x") + 1)
  negmissing = Num(of: -number("x"))
  divzero = Num(of: 1 / number("0"))
}

item vergleiche "Vergleiche und Logik" {
  lt = Flag(of: 1/3 < 1/2)
  ge = Flag(of: 2 >= 2.0)
  eq = Flag(of: 0.5 == 1/2)
  ltnone = Flag(of: number("x") < 1)
  gtnone = Flag(of: number("x") > 1)
  eqnone = Flag(of: number("x") == none)
  nenone = Flag(of: number("1") != none)
  ifnone = Num(of: if number("x") > 0 then 1 else 2)
  inrange = Flag(of: 3/5 in 1/2 .. 7/10)
  atbound = Flag(of: 7/10 in 1/2 .. 7/10)
  outrange = Flag(of: 4/5 in 1/2 .. 7/10)
  nonein = Flag(of: number("x") in 0 .. 1)
  inset = Flag(of: 2 in {1, 2})
  inlist = Flag(of: "b" in ["a", "b"])
  andor = Flag(of: true and not false or false)
}

item sammlungen "Mengen und Listen" {
  ordered = Nums(of: {3, 1/2, 2, 1})
  dedup = Nums(of: {2, 2.0, 4/2})
  union = Nums(of: {1, 2} + {2, 3})
  diff = Nums(of: {1, 2, 3} - {2})
  seteq = Flag(of: {2, 1} == {1, 2})
  listeq = Flag(of: [1, 2] == [2, 1])
  second = Num(of: [10, 20, 30][2])
  beyond = Num(of: [10, 20][5])
  zeroth = Num(of: [10, 20][0])
  size_set = Num(of: size({1, 2, 2}))
  size_list = Num(of: size([1, 1]))
  counted = Num(of: count([1, 2, 1], 1))
  counted_in = Num(of: count_in([1, 2, 3], {1, 3}))
  repeated = TxtList(of: repeat("a", 3))
  replaced = NumList(of: replace([1, 2, 3], 2, 9))
  replaced_out = NumList(of: replace([1, 2, 3], 5, 9))
}

item texte "Text und Inhalt" {
  concat = Txt(of: "Teil " + 3)
  fraction = Txt(of: "a" + 7/2)
  negative = Txt(of: "n" + (0 - 3/4))
  boolean = Txt(of: "x" + true)
  point_text = Txt(of: "p" + (1 | 2))
  set_text = Txt(of: "s" + {2, 1})
  list_text = Txt(of: "l" + [1, 2])
  none_text = Txt(of: "n" + number("x"))
  marked = Rich(of: emph("x"))
  sequence = Rich(of: "a " + del("b"))
  picture = Rich(of: image("https://example.org/a.png", "Bild"))
  formula = Rich(of: math("x^2"))
}
